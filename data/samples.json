  "chopStyles": [
    { "id": "one-shot",     "name": "One-Shot Chops",     "note": "Slice to single hits and replay the melody." },
    { "id": "loop",         "name": "Straight Loop",      "note": "One bar, untouched. Make the drums do the work." },
    { "id": "sixteenths",   "name": "16-Slice Grid",      "note": "Chop to 16ths and rearrange the order." },
    { "id": "stutter",      "name": "Stutter Chop",       "note": "Repeat a fragment until it stops sounding like music." },
    { "id": "pitch-ladder", "name": "Pitch Ladder",       "note": "Same chop, four different pitches, one phrase." },
    { "id": "time-stretch", "name": "Extreme Stretch",    "note": "Stretch a 2-second sample across 4 bars." },
    { "id": "reverse",      "name": "Reverse Chop",       "note": "Flip the sample, then chop the flip." },
    { "id": "layered",      "name": "Two-Sample Layer",   "note": "Stack two unrelated loops in the same key." },
    { "id": "granular",     "name": "Granular Freeze",    "note": "Freeze one grain and build the pad from it." },
    { "id": "filtered",     "name": "Filter Isolation",   "note": "Filter out everything except one element." },
    { "id": "tail-only",    "name": "Tails Only",         "note": "Use only the decay, never the attack." },
    { "id": "microchop",    "name": "Microchop",          "note": "Slices under 100ms. Rebuild the phrase note by note." }
  ],

  "processing": [
    { "id": "vinyl-sim",     "name": "Vinyl Simulation",    "note": "Crackle, rumble, and a slight speed drift." },
    { "id": "tape-sat",      "name": "Tape Saturation",     "note": "Drive it until the transients soften." },
    { "id": "bitcrush",      "name": "Bitcrush",            "note": "12-bit or lower. Keep the aliasing." },
    { "id": "pitch-down",    "name": "Pitched Down",        "note": "Drop it 3-6 semitones without correcting formants." },
    { "id": "pitch-up",      "name": "Pitched Up",          "note": "Chipmunk it. Commit fully." },
    { "id": "lowpass",       "name": "Heavy Lowpass",       "note": "Cut everything above 6kHz and never bring it back." },
    { "id": "reverb-drench", "name": "Reverb Drenched",     "note": "Print the reverb into the sample. No dry signal." },
    { "id": "mono-fold",     "name": "Folded To Mono",      "note": "Collapse the stereo image, then re-widen with delay." },
    { "id": "clean",         "name": "Untouched",           "note": "No processing at all. Trust the record." },
    { "id": "phaser",        "name": "Phaser / Flanger",    "note": "Slow sweep across the whole loop." },
    { "id": "sidechained",   "name": "Sidechained",         "note": "Duck the sample under the kick, hard." },
    { "id": "resampled",     "name": "Resampled Twice",     "note": "Bounce, reimport, process again, bounce again." }
  ]
